# Frontier Tracker API keys and runtime configuration.
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Real secret values live ONLY in `.env` (which is gitignored). The scripts read
# them via a shared bootstrap (`scripts/_bootstrap.py`). Variables already set in
# your shell take precedence over values here.

# OpenAlex — REQUIRED by scan_recent_papers.py and enrich_abstracts.py.
# OpenAlex has required an API key for full rate limits since 2026-02-13.
# Get one at https://openalex.org/settings/api
OPENALEX_API_KEY=

# DeepSeek — REQUIRED by enrich_and_judge.py (LLM translation + relevance judgment).
# Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Elsevier ScienceDirect — OPTIONAL. Only needed to fetch abstracts for fresh
# Elsevier journals (JUE/JPubE/JHE/JDE/EER/JEEM/JIE) that OpenAlex/Crossref/S2
# can't return. A bare API key only returns titles; you also need an institution
# token. Register at https://dev.elsevier.com/ ; insttoken via CUFE library.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=

# Vault root for render_display_outputs.py --mode orient-stubs.
# Defaults to ~/Documents/marginal-notes. Override only if the vault moves.
FRONTIER_TRACKER_VAULT_ROOT=/Users/fanfan/Documents/marginal-notes
